{
  "name": "craftpages",
  "productName": "CraftPages",
  "version": "1.1.5",
  "description": "Desktop CMS for plain-HTML static sites: edit text, images and SEO in place, publish to Cloudflare",
  "main": "./out/main/index.js",
  "author": "Vitalii Kiiko",
  "license": "GPL-3.0-or-later",
  "homepage": "https://craftpages.app",
  "repository": "github:moomoo-agency/craftpages",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && node scripts/mac-sharp.mjs && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux deb --publish never && electron-builder --linux AppImage --publish never -c.afterPack=scripts/appimage-launcher.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "basic-ftp": "^6.2.1",
    "electron-updater": "^6.8.9",
    "parse5": "^8.0.1",
    "sharp": "^0.35.4",
    "ssh2-sftp-client": "^12.1.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@wordpress/block-editor": "^18.0.0",
    "@wordpress/block-library": "^11.1.0",
    "@wordpress/blocks": "^16.1.0",
    "@wordpress/components": "^41.0.0",
    "@wordpress/data": "^10.56.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/format-library": "^5.56.0",
    "@wordpress/icons": "^17.0.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
